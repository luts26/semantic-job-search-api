APP_NAME=Semantic Job Search API
APP_ENV=smoke
APP_DEBUG=false

POSTGRES_DB=semantic_jobs_smoke
POSTGRES_USER=semantic_jobs_smoke_app
POSTGRES_PASSWORD=smoke_test_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=job_vacancies_smoke

WORKUA_REQUEST_TIMEOUT=20
WORKUA_MIN_DELAY_SECONDS=0.6
WORKUA_MAX_DELAY_SECONDS=1.5

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
